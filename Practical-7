<!DOCTYPE html>
<html>
<head>
    <title>Interactive FAQ</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen bg-gradient-to-r from-blue-300 to-violet-300 flex items-center justify-center">

    <div class="bg-white p-8 rounded-xl shadow-lg w-96">

        <h2 class="text-2xl font-bold text-center text-sky-800 mb-9">
            College Library Portal
        </h2>

        <p class="text-center mb-5 text-blue-700">
            Most Asked Questions
        </p>

        <!-- FAQ 1 -->
        <div class="mb-3">
            <button class="question w-full text-left p-3 bg-gradient-to-r from-blue-500 to-violet-500 text-white rounded">
                How can I search for a book online?
            </button>

            <p class="answer hidden p-3 bg-purple-50">
                You can search for books using the library's online catalog.
            </p>
        </div>

        <!-- FAQ 2 -->
        <div class="mb-3">
            <button class="question w-full text-left p-3 bg-gradient-to-r from-blue-500 to-violet-500 text-white rounded">
                How can I check whether a book is available?
            </button>

            <p class="answer hidden p-3 bg-purple-50">
                You can check the availability of a book by searching for it in the online catalog. The catalog will show you if the book is available or checked out.
            </p>
        </div>

        <!-- FAQ 3 -->
        <div class="mb-3">
            <button class="question w-full text-left p-3 bg-gradient-to-r from-blue-500 to-violet-500 text-white rounded">
                Can I renew a borrowed book online?
            </button>

            <p class="answer hidden p-3 bg-purple-50">
                Yes, you can renew borrowed books through the library's online portal.
            </p>
        </div>
                <!-- FAQ 4 -->
        <div class="mb-3">
            <button class="question w-full text-left p-3 bg-gradient-to-r from-blue-500 to-violet-500 text-white rounded">
                How can I check due dates?
            </button>

            <p class="answer hidden p-3 bg-purple-50">
                You can check the due dates of your borrowed books in the "My Account" section of the library's online portal.
            </p>
        </div>
<!-- FAQ 5 -->
        <div class="mb-3">
            <button class="question w-full text-left p-3 bg-gradient-to-r from-blue-500 to-violet-500 text-white rounded">
                How can I request a book that is not available?
            </button>

            <p class="answer hidden p-3 bg-purple-50">
                You can request a book that is not available through the library's online portal. The system will notify you when the book is available.
            </p>
        </div>

            </p>
        </div>

    </div>


    <script>

        // Get all questions
        let questions = document.querySelectorAll(".question");

        // Add click event to each question
        questions.forEach(function(question) {

            question.addEventListener("click", function() {

                // Get the answer
                let answer = question.nextElementSibling;

                // Show / Hide answer
                answer.classList.toggle("hidden");

            });

        });

    </script>

</body>
</html>

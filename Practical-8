<!DOCTYPE html>
<html>
<head>
    <title>Student Registration</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-sky-100">
    <div class="max-w-md mx-auto mt-10 bg-white p-6 rounded shadow">

        <h2 class="text-2xl font-bold mb-5 text-center">
            Student Registration
        </h2>

        <form id="registrationForm">
            <!-- Name -->
            <label>Student Name</label>
            <input type="text" id="name"
                class="w-full border p-2 mb-3 rounded">
            <!-- Email -->
            <label>Email</label>
            <input type="text" id="email"
                class="w-full border p-2 mb-3 rounded">
            <!-- Password -->
            <label>Password</label>
            <input type="password" id="password"
                class="w-full border p-2 rounded">

            <!-- Show / Hide Button -->
            <button type="button" onclick="showPassword()"
                id="showBtn"
                class="mt-2 bg-gray-300 px-3 py-1 rounded">
                Show Password
            </button>

            <!-- Mobile -->
            <label class="block mt-3">Mobile Number</label>
            <input type="text" id="mobile"
                class="w-full border p-2 mb-4 rounded">

            <button type="submit"
                class="w-full bg-blue-500 text-white p-2 rounded">
                Register
            </button>

            <p id="message" class="mt-4 text-center"></p>
        </form>
    </div>
    <script>

        // Show / Hide Password
        function showPassword() {

            let password = document.getElementById("password");
            let showBtn = document.getElementById("showBtn");

            if (password.type == "password") {
                password.type = "text";
                showBtn.innerHTML = "Hide Password";
            }
            else {
                password.type = "password";
                showBtn.innerHTML = "Show Password";
            }
        }
        document.getElementById("registrationForm").onsubmit = function(event) {

            event.preventDefault();

            let name = document.getElementById("name").value;
            let email = document.getElementById("email").value;
            let password = document.getElementById("password").value;
            let mobile = document.getElementById("mobile").value;

            let message = document.getElementById("message");
            // Mandatory fields
            if (name == "" || email == "" || password == "" || mobile == "") {

                message.innerHTML = "Please fill all fields.";
                message.className = "mt-4 text-center text-red-500";

                return;
            }
            // Email validation
            if (!email.includes("@") || !email.includes(".")) {

                message.innerHTML = "Enter a valid email.";
                message.className = "mt-4 text-center text-red-500";

                return;
            }
            // Password 6 character validation
            if (password.length < 6) {

                message.innerHTML = "Password must be at least 6 characters.";
                message.className = "mt-4 text-center text-red-500";

                return;
            }
            // Special character validation
            
              if (!password.includes("@")&& !password.includes("#") && !password.includes("$") && !password.includes("!") && !password.includes("%") && !password.includes("&") && !password.includes("*")) {
                message.innerHTML = "Password must contain at least one special character.";
                message.className = "mt-4 text-center text-red-500";

                return;
            }
            // Mobile validation
            if (mobile.length != 10 || isNaN(mobile)) {

                message.innerHTML = "Enter a valid 10-digit mobile number.";
                message.className = "mt-4 text-center text-red-500";

                return;
            }
            // Success
            message.innerHTML = "Registration Successful!";
            message.className = "mt-4 text-center text-green-500";
        };

    </script>

</body>
</html>

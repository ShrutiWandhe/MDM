<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reusable UI Components - Tailwind CSS</title>

  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gradient-to-br from-sky-700 via-indigo-400 to-pink-400 min-h-screen text-slate-800">
  <!-- Subtle Background Glowing Orbs for Light Theme -->
  <div class="absolute top-0 left-1/4 w-96 h-96 bg-cyan-300/30 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-1/3 right-10 w-96 h-96 bg-indigo-300/30 rounded-full blur-3xl pointer-events-none"></div>

  <!-- ================= NAVBAR ================= -->

  <nav class="bg-white/70 border-b border-slate-200/80 text-slate-800 p-4 shadow-sm sticky top-0 z-50 backdrop-blur-md">
    <div class="max-w-6xl mx-auto flex justify-between items-center">
      <h1 class="text-2xl font-black tracking-wider text-transparent bg-clip-text bg-gradient-to-r from-cyan-600 to-blue-600">
        SHRUTI  IT25053
      </h1>

      <div class="space-x-6 font-medium text-slate-600">
        <a href="#" class="hover:text-cyan-600 transition-colors duration-200">Home</a>
        <a href="#" class="hover:text-cyan-600 transition-colors duration-200">Services</a>
        <a href="#" class="hover:text-cyan-600 transition-colors duration-200">Login</a>
        <a href="#" class="hover:text-cyan-600 transition-colors duration-200">Contact</a>
      </div>
    </div>
  </nav>

  <!-- ================= HEADING & HIGHLIGHTED TAGLINE ================= -->

  <section class="text-center py-10 px-4 relative z-10">
    <h2 class="text-4xl md:text-5xl font-black text-transparent bg-clip-text bg-gradient-to-r from-slate-900 via-indigo-950 to-blue-900 mb-4 tracking-tight">
      Latest SmartTV Collection
    </h2>

    <!-- High-visibility Flash Sale Tagline Badge -->
    <div class="inline-flex items-center gap-2 bg-gradient-to-r from-amber-500/10 via-orange-500/10 to-amber-500/10 border border-amber-400/60 shadow-md rounded-full px-6 py-2.5 backdrop-blur-md">
    
      <p class="text-amber-900 font-bold text-sm md:text-bold tracking-wide">
        Shop Now!! Don't Miss Out on Our 24-Hour Flash Sale! Get 40% OFF on All Items 
      </p>
    </div>
  </section>

  <!-- ================= CARD SECTION ================= -->

  <section class="max-w-6xl mx-auto px-5 relative z-10">

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">

      <!-- Card 1: Samsung TV -->
      <div class="bg-white/90 border border-slate-200/80 rounded-2xl shadow-lg hover:shadow-2xl overflow-hidden hover:border-cyan-400/80 transition-all duration-700 group flex flex-col justify-between">
        <div>
          <div class="relative overflow-hidden bg-slate-100 flex items-full justify-center">
            <!-- Fixed Image Height (h-52) & Uniform Fit -->
            <img
              src="i3.jpg"
              alt="Samsung TV"
              class="w-full h-52 object-cover p-2 group-hover:scale-105 transition-transform duration-500"
            >
          </div>

          <div class="p-6">
            <h3 class="text-xl font-bold mb-2 text-slate-800">
              Samsung TV <span class="text-xs bg-slate-100 border border-slate-200 text-slate-600 px-2 py-0.5 rounded-full ml-1"></span>
            </h3>
            <p class="text-slate-600 text-sm leading-relaxed">
              Samsung 138 cm (55 Inch) 4K QLED Smart LED TV (55Q7F)
            </p>
          </div>
        </div>

        <div class="px-6 pb-6 pt-2">
          <!-- Cyan to Blue Gradient Button -->
          <button class="w-full bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-600 hover:to-blue-700 text-white font-bold py-3 rounded-full shadow-md hover:shadow-cyan-500/25 transition-all duration-300">
            Read More
          </button>
        </div>
      </div>

      <!-- Card 2: Haier TV -->
      <div class="bg-white/90 border border-slate-200/80 rounded-2xl shadow-lg hover:shadow-2xl overflow-hidden hover:border-violet-400/80 transition-all duration-300 group flex flex-col justify-between">
        <div>
          <div class="relative overflow-hidden bg-slate-100 flex items-center justify-center">
            <!-- Fixed Image Height (h-52) & Uniform Fit -->
            <img
              src="i4.webp"
              alt="Haier TV"
              class="w-full h-52 object-contain p-2 group-hover:scale-105 transition-transform duration-500"
            >
          </div>

          <div class="p-6">
            <h3 class="text-xl font-bold mb-2 text-slate-800">
              Haier TV <span class="text-xs bg-slate-100 border border-slate-200 text-slate-600 px-2 py-0.5 rounded-full ml-1"></span>
            </h3>
            <p class="text-slate-600 text-sm leading-relaxed">
              Haier W4G 80 cm (32 inch) HD Ready LED Smart Google TV 2025
            </p>
          </div>
        </div>

        <div class="px-6 pb-6 pt-2">
          <!-- Violet to Purple Gradient Button -->
          <button class="w-full bg-gradient-to-r from-violet-500 to-purple-600 hover:from-violet-600 hover:to-purple-700 text-white font-bold py-3 rounded-full shadow-md hover:shadow-violet-500/25 transition-all duration-300">
            Learn More
          </button>
        </div>
      </div>

      <!-- Card 3: Realme TV -->
      <div class="bg-white/90 border border-slate-200/80 rounded-2xl shadow-lg hover:shadow-2xl overflow-hidden hover:border-emerald-400/80 transition-all duration-300 group flex flex-col justify-between">
        <div>
          <div class="relative overflow-hidden bg-slate-100 flex items-center justify-center">
            <!-- Fixed Image Height (h-52) & Uniform Fit -->
            <img
              src="i5.jpg"
              alt="Realme TV"
              class="w-full h-52 object-contain p-2 group-hover:scale-105 transition-transform duration-500"
            >
          </div>

          <div class="p-6">
            <h3 class="text-xl font-bold mb-2 text-slate-800">
              Realme TV <span class="text-xs bg-slate-100 border border-slate-200 text-slate-600 px-2 py-0.5 rounded-full ml-1"></span>
            </h3>
            <p class="text-slate-600 text-sm leading-relaxed">
              realme TechLife 108 cm (43 inch) Ultra HD (4K) LED Smart Google TV 2026 Edition
            </p>
          </div>
        </div>

        <div class="px-6 pb-6 pt-2">
          <!-- Emerald to Teal Gradient Button -->
          <button class="w-full bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-600 hover:to-teal-700 text-white font-bold py-3 rounded-full shadow-md hover:shadow-emerald-500/25 transition-all duration-300">
            Explore
          </button>
        </div>
      </div>

      <!-- Card 4: Vision World TV -->
      <div class="bg-white/90 border border-slate-200/80 rounded-2xl shadow-lg hover:shadow-2xl overflow-hidden hover:border-amber-400/80 transition-all duration-300 group flex flex-col justify-between">
        <div>
          <div class="relative overflow-hidden bg-slate-100 flex items-center justify-center">
            <!-- Fixed Image Height (h-52) & Uniform Fit -->
            <img
              src="i6.jpg"
              alt="Vision World TV"
              class="w-full h-52 object-contain p-2 group-hover:scale-105 transition-transform duration-500"
            >
          </div>

          <div class="p-6">
            <h3 class="text-xl font-bold mb-2 text-slate-800">
              Vision World TV <span class="text-xs bg-slate-100 border border-slate-200 text-slate-600 px-2 py-0.5 rounded-full ml-1"></span>
            </h3>
            <p class="text-slate-600 text-sm leading-relaxed">
              VW 60 cm (24 inch) HD Ready LED TV 2025 Edition (VW24A)
            </p>
          </div>
        </div>

        <div class="px-6 pb-6 pt-2">
          <!-- Amber to Orange Gradient Button -->
          <button class="w-full bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-600 hover:to-orange-700 text-white font-bold py-3 rounded-full shadow-md hover:shadow-amber-500/25 transition-all duration-300">
            Read More
          </button>
        </div>
      </div>

      <!-- Card 5: XIAOMI TV -->
      <div class="bg-white/90 border border-slate-200/80 rounded-2xl shadow-lg hover:shadow-2xl overflow-hidden hover:border-pink-400/80 transition-all duration-300 group flex flex-col justify-between">
        <div>
          <div class="relative overflow-hidden bg-slate-100 flex items-center justify-center">
            <!-- Fixed Image Height (h-52) & Uniform Fit -->
            <img
              src="i7.jpg"
              alt="XIAOMI TV"
              class="w-full h-52 object-contain p-2 group-hover:scale-105 transition-transform duration-500"
            >
          </div>

          <div class="p-6">
            <h3 class="text-xl font-bold mb-2 text-slate-800">
              XIAOMI TV <span class="text-xs bg-slate-100 border border-slate-200 text-slate-600 px-2 py-0.5 rounded-full ml-1"></span>
            </h3>
            <p class="text-slate-600 text-sm leading-relaxed">
              XIAOMI A 80 cm (32 inch) HD Ready LED Smart Google TV with 200+ Free Channels
            </p>
          </div>
        </div>

        <div class="px-6 pb-6 pt-2">
          <!-- Pink to Rose Gradient Button -->
          <button class="w-full bg-gradient-to-r from-pink-500 to-rose-600 hover:from-pink-600 hover:to-rose-700 text-white font-bold py-3 rounded-full shadow-md hover:shadow-pink-500/25 transition-all duration-300">
            Read More
          </button>
        </div>
      </div>

      <!-- Card 6: Sony TV -->
      <div class="bg-white/90 border border-slate-200/80 rounded-2xl shadow-lg hover:shadow-2xl overflow-hidden hover:border-indigo-400/80 transition-all duration-300 group flex flex-col justify-between">
        <div>
          <div class="relative overflow-hidden bg-slate-100 flex items-center justify-center">
            <!-- Fixed Image Height (h-52) & Uniform Fit -->
            <img
              src="i8.jpg"
              alt="Sony TV"
              class="w-full h-52 object-contain p-2 group-hover:scale-105 transition-transform duration-500"
            >
          </div>

          <div class="p-6">
            <h3 class="text-xl font-bold mb-2 text-slate-800">
              Sony TV <span class="text-xs bg-slate-100 border border-slate-200 text-slate-600 px-2 py-0.5 rounded-full ml-1"></span>
            </h3>
            <p class="text-slate-600 text-sm leading-relaxed">
              Sony BRAVIA 2 II 4K Ultra HD Smart LED Google TV
            </p>
          </div>
        </div>

        <div class="px-6 pb-6 pt-2">
          <!-- Indigo to Blue Gradient Button -->
          <button class="w-full bg-gradient-to-r from-indigo-500 to-blue-600 hover:from-indigo-600 hover:to-blue-700 text-white font-bold py-3 rounded-full shadow-md hover:shadow-indigo-500/25 transition-all duration-300">
            Read More
          </button>
        </div>
      </div>

    </div>

  </section>

  <!-- ================= FOOTER ================= -->

  <footer class="mt-20 bg-slate-900 text-slate-100 relative z-10">
    <div class="max-w-6xl mx-auto py-10 text-center px-4">
      <h2 class="text-2xl font-black text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-400">
        Silver Gadget Shop
      </h2>

      <p class="mt-2 text-slate-400 text-sm">
        Gandibagh Road, Nagpur-447098
      </p>

      <p class="mt-4 text-xs text-slate-500">
        © 2026 All Rights Reserved
      </p>
    </div>
  </footer>

  
  </section>

</body>
</html>
